rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'xp', 'hearts', 'streak', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.xp is number && data.xp >= 0
        && data.hearts is number && data.hearts >= 0 && data.hearts <= 10
        && data.streak is number && data.streak >= 0
        && data.updatedAt is string && data.updatedAt.size() <= 100
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 255))
        && (!('lastActiveDate' in data) || (data.lastActiveDate is string && data.lastActiveDate.size() <= 30))
        && (!('completedLessons' in data) || (data.completedLessons is string && data.completedLessons.size() <= 4000))
        && (!('unlockedNodes' in data) || (data.unlockedNodes is string && data.unlockedNodes.size() <= 4000))
        && (!('savedVocabulary' in data) || (data.savedVocabulary is string && data.savedVocabulary.size() <= 10000))
        && (!('customSections' in data) || (data.customSections is string && data.customSections.size() <= 50000));
    }

    function isValidHistory(data, userId) {
      return data.keys().hasAll(['userId', 'sessionType', 'score', 'xpEarned'])
        && data.userId is string && data.userId == userId
        && data.sessionType is string && data.sessionType.size() <= 50
        && data.score is number
        && data.xpEarned is number;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);

      match /history/{historyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(historyId) && isValidHistory(request.resource.data, userId);
        allow update, delete: if isOwner(userId);
      }
    }
  }
}
